              "action_class": "goal",
              "gain": 0.0,
              "errors": 0
            }
          },
          {
            "event_id": "s02",
            "t_ms": 1000,
            "kind": "action",
            "payload": {
              "objective_id": "task-01",
              "phase": "build",
              "action_class": "build",
              "gain": 0.6,
              "errors": 0
            }
          },
          {
            "event_id": "s03",
            "t_ms": 2000,
            "kind": "outcome",
            "payload": {
              "objective_id": "task-01",
