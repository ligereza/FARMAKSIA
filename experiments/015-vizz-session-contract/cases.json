    {
      "id": "reject-raw-text",
      "session": {
        "schema": "farmaxia:vizz-session:0.1",
        "consent": {
          "granted": true,
          "scope": "task_events_only",
          "raw_capture": false
        },
        "capture": {
          "enabled": true,
          "source": "manual_event_adapter"
        },
        "events": [
          {
            "event_id": "bad01",
            "t_ms": 0,
            "kind": "action",
            "payload": {
              "action_class": "build",
              "text": "private content must not enter this contract"
            }
          }
        ]
      },
      "expected": "invalid"
